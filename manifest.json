{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:sentinel-risk-scanner",
      "version": "latest"
    }
  ],
  "tags": ["security", "web3", "evm", "scanner", "audit"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Sentinel Risk Scanner",
        "default": true,
        "default_size": { "w": 1020, "h": 760 },
        "min_size": { "w": 780, "h": 540 },
        "max_size": { "w": 1400, "h": 950 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:sentinel-risk-scanner"],
      "chat": ["write_message"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
