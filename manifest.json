{
  "schema": 2,
  "permissions": [
    "tools.invoke",
    "chat.write_message",
    "storage.read",
    "storage.write",
    "ui.svg"
  ],
  "required_executas": [
    {
      "tool_id": "bundled:sentinel-risk-scanner",
      "version": "latest"
    }
  ],
  "system_prompt_addendum": "The user has Sentinel Web3 Risk Scanner open. When inspecting EVM calldata, smart contracts, or transaction reverts, leverage Sentinel's AI Security Reasoning Engine to perform intent divergence analysis, correlate multi-signal exploit vectors, and suggest safe bounded calldata remediations.",
  "user_message_prefix_template": "[Sentinel Security] {user_message}",
  "tags": ["security", "web3", "evm", "scanner", "audit", "ai-reasoning"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Sentinel Risk Scanner",
        "default": true,
        "default_size": { "w": 1020, "h": 760 },
        "min_size": { "w": 780, "h": 540 },
        "max_size": { "w": 1400, "h": 950 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:sentinel-risk-scanner"],
      "chat": ["write_message"],
      "storage": ["get", "set"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
